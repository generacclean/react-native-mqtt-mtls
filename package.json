{
  "name": "@generacclean/react-native-mqtt-mtls",
  "version": "1.4.1",
  "description": "A React Native MQTT client with mTLS (mutual TLS) support",
  "main": "index.ts",
  "types": "index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:android": "cd android && ./gradlew test",
    "test:ios": "swift test",
    "test:ios:xcode": "cd ios && xcodebuild test -scheme MqttModule -destination 'platform=iOS Simulator,name=iPhone 17 Pro'",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "mqtt",
    "mtls",
    "tls",
    "ssl",
    "android",
    "ios",
    "iot",
    "messaging"
  ],
  "author": "Ved Yedla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generacclean/react-native-mqtt-mtls.git"
  },
  "bugs": {
    "url": "https://github.com/generacclean/react-native-mqtt-mtls/issues"
  },
  "homepage": "https://github.com/generacclean/react-native-mqtt-mtls#readme",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.70.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.6.0"
  },
  "//files": "This allowlist is the only control over what publishes: npm builds the tarball from it, and a .npmignore cannot subtract from what it names. Keep the entries specific — broadening one to a whole platform directory (\"android/\", \"ios/\") ships Gradle and Xcode build output. Verify with `npm pack --dry-run` after editing.",
  "files": [
    "android/build.gradle",
    "android/settings.gradle",
    "android/gradle.properties",
    "android/proguard-rules.pro",
    "android/src/main/",
    "ios/MqttModule.swift",
    "ios/MqttModule.m",
    "ios/TrustValidation/",
    "ios/react-native-mqtt-mtls-Bridging-Header.h",
    "src/",
    "index.ts",
    "index.d.ts",
    "react-native.config.js",
    "react-native-mqtt-mtls.podspec",
    "README.md",
    "LICENSE"
  ]
}
